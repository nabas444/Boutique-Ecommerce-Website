# Backend environment variables (example)
# Do NOT commit real secrets. Copy this to `.env` and fill values locally or use a secrets manager.

# OpenAI (optional)
OPENAI_API_KEY=

# Google Gemini / Vertex (optional)
GEMINI_API_KEY=
GEMINI_API_URL=

# Grok (optional)
GROK_API_KEY=
GROK_COMPLETION_URL=https://api.grok.ai/v1/completions

# Hugging Face (optional)
HF_API_KEY=
HF_MODEL=google/flan-t5-small

# Database / other
DATABASE_URL=
REDIS_URL=

# Example: to enable Gemini, set GEMINI_API_KEY and GEMINI_API_URL locally.
